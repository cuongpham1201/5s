# ============================================================
# 5S Daily — environment variables (EXAMPLE / placeholders)
# Copy to .env.local and fill REAL values at deploy time.
# NEVER commit real secrets. .env* is gitignored.
# See docs/ENVIRONMENT_SETUP.md for details.
# ============================================================

# --- Auth.js core ---
AUTH_SECRET="dev-only-change-me"            # generate: npx auth secret
NEXTAUTH_URL="http://localhost:3000"

# --- Microsoft Entra ID (M365) login — delegated, scope User.Read ---
# Leaving CLIENT_ID/SECRET empty keeps the Microsoft button hidden and
# falls back to dev mock login.
AUTH_AZURE_AD_CLIENT_ID=""
AUTH_AZURE_AD_CLIENT_SECRET=""
AUTH_AZURE_AD_TENANT_ID=""

# --- Microsoft Graph app-only (Phase 2: SharePoint) — not used in Phase 1B ---
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_TENANT_ID=""

# --- Postgres: 5S business DB + HRM master (Phase 1) ---
# BAN5S_DATABASE_URL: DB nghiệp vụ RIÊNG của app 5S (đọc/ghi). KHÔNG dùng chung với HRM.
#   (Tên biến KHÔNG bắt đầu bằng số — "5S_DATABASE_URL" không hợp lệ trong shell/dotenv.)
BAN5S_DATABASE_URL="postgres://ban5s:CHANGE_ME@localhost:5432/ban5s_app"
# HRM_DATABASE_URL: master nhân viên/phòng ban — CHỈ ĐỌC. App tuyệt đối không ghi vào HRM.
HRM_DATABASE_URL="postgres://READONLY_USER:CHANGE_ME@localhost:5432/biahalong_cb"
HRM_SYNC_ENABLED="false"                     # bật/tắt sync HRM (Phase sau dùng cho cron/API)
HRM_SYNC_CRON_FULL="0 2 * * *"               # lịch full sync (Phase sau)

# --- Optional ---
SHAREPOINT_SITE_URL=""                       # Phase 2
NEXT_PUBLIC_ALLOW_DEV_LOGIN="true"           # set "false" in production
NEXT_PUBLIC_USE_MOCK_DATA="false"            # mock fallback only when "true" AND dev login on; product keeps "false"
ADMIN_EMAILS="cuongpx@biahalong.com"         # comma-separated admin emails; default admin cuongpx@biahalong.com is always admin
NEXT_PUBLIC_CAPTURE_DEBUG="false"            # "true" shows the on-screen capture debug panel on /preview + /session (console.warn [5S_CAPTURE_DEBUG] always on)
