# ============================================================
# 5S Daily — environment variables (EXAMPLE / placeholders)
# Copy to .env.local and fill REAL values in Phase 1B.
# NEVER commit real secrets. .env* is gitignored.
# ============================================================

# Auth.js core
AUTH_SECRET="dev-only-change-me-in-prod"   # generate: npx auth secret
NEXTAUTH_URL="http://localhost:3000"

# Microsoft Entra ID (M365) — fill in Phase 1B when an App Registration exists.
# Leaving these empty keeps the Entra button hidden and falls back to dev mock login.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""   # e.g. https://login.microsoftonline.com/<TENANT_ID>/v2.0

# Local development convenience.
# When "true", a mock credentials sign-in is available so the app runs without real Entra.
NEXT_PUBLIC_ALLOW_DEV_LOGIN="true"
